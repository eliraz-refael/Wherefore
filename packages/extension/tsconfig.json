{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "jsx": "react-jsx"
  },
  // .wxt/wxt.d.ts is generated by `wxt prepare` (postinstall): import.meta.env and public paths.
  // WXT's own .wxt/tsconfig.json is not extended; the strict base config stays in charge.
  "include": ["src", "test", "wxt.config.ts", ".wxt/wxt.d.ts"]
}
