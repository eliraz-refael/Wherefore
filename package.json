{
  "name": "tabs-intent-poc",
  "private": true,
  "version": "0.0.1",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "typecheck:packages": "pnpm -r --filter \"@wherefore/*\" typecheck",
    "test:packages": "pnpm -r --filter \"@wherefore/*\" test",
    "postinstall": "wxt prepare",
    "build:all": "wxt build && pnpm -C companion install && pnpm -C companion build",
    "companion:install": "node companion/dist/cli.js install"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "wxt": "^0.21.4"
  }
}
